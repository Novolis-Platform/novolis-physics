<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Avoid restore failures when the user-level cache has locked testing-platform binaries (e.g. Rider test host). -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
