<Project>
  <PropertyGroup Label="Novolis.Physics NuGet metadata">
    <Authors>Novolis</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Novolis-Platform/novolis-physics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Novolis-Platform/novolis-physics</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>physics;simulation;orbits;ballistics;gravity</PackageTags>
  </PropertyGroup>
</Project>
